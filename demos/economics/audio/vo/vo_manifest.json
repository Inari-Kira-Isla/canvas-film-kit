  "lines": {
    "N1": {
      "text": "通脹即係話，同一樣嘢，過一排時間之後，要俾多咗錢先至買得到。",
      "voice": "default",
      "speech_len": 5.42
    },
    "N2": {
      "text": "喺我哋虛構嘅小島度，麵包價由第一年到第四年，一路慢慢升。",
      "voice": "default",
      "speech_len": 5.21
    },
    "N3": {
      "text": "四年之間，麵包價總共升咗一半，即係通脹率大約百分之五十。",
      "voice": "default",
      "speech_len": 5.21
    },
    "N4": {
      "text": "呢間燈塔麵包舖嘅價錢，就係我哋今日示範用嘅示意數據。",
      "voice": "default",
      "speech_len": 5
    }
  }
}
