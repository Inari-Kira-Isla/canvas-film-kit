  "lines": {
    "N1": {
      "text": "十五世紀中期，喺德國美因茲，有工匠開始試用活字嚟印刷書籍。",
      "voice": "default",
      "speech_len": 5.42
    },
    "N2": {
      "text": "呢種技術好快由美因茲，傳去斯特拉斯堡、威尼斯同巴黎呢幾個城市。",
      "voice": "default",
      "speech_len": 5.83
    },
    "N3": {
      "text": "據載，短短幾十年間，歐洲各地印刷作坊嘅數量增長咗好多。",
      "voice": "default",
      "speech_len": 5
    },
    "N4": {
      "text": "到咗1500年，活字印刷術已經傳遍咗歐洲絕大部分嘅主要城市。",
      "voice": "default",
      "speech_len": 5
    }
  }
}
